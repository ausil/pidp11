[Unit]
Description=PiDP-11 SIMH simulator (console in a screen session)
After=pidp11-server.service
Requires=pidp11-server.service

[Service]
Type=forking
User=pidp11
Group=pidp11
RuntimeDirectory=pidp11
WorkingDirectory=/var/lib/pidp11/systems
# Attach with: pdp11   (see /usr/share/pidp11/README for the sudo setup)
ExecStart=/usr/bin/screen -dmS pidp11 /usr/libexec/pidp11/pidp11-run
ExecStop=/usr/bin/screen -S pidp11 -X quit
# pcap networking without running as root
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
Restart=on-failure

[Install]
WantedBy=multi-user.target
